# Copy to .env and adjust. Docker Compose reads this file automatically;
# the Go server reads these from its environment.

# --- Database (used by docker-compose.yml) ---
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chatapp

# --- Backend ---
# "development" uses local defaults for anything unset;
# "production" requires DATABASE_URL, JWT_SECRET and ALLOWED_ORIGINS
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://chatuser:chatpass@localhost:5432/chatapp?sslmode=disable
# At least 32 random characters in production, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Comma-separated list of frontend URLs allowed to call the API and open WebSockets
ALLOWED_ORIGINS=http://localhost:3000
