# Copy to .env and adjust. Docker Compose and the Go server both read it;
# variables already set in your environment take priority over this file.
# The server looks for .env in its working directory and then each parent up
# to the project root, or set ENV_FILE to use a different file.

# --- Database (used by docker-compose.yml) ---
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chatapp

# --- Backend ---
# "development" uses local defaults for anything unset;
# "production" requires DATABASE_URL, JWT_SECRET and ALLOWED_ORIGINS
APP_ENV=development
PORT=8080
# Keep the user, password and database name in step with the POSTGRES_* values above
DATABASE_URL=postgres://chatuser:chatpass@localhost:5432/chatapp?sslmode=disable
# At least 32 random characters in production, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Comma-separated list of frontend URLs allowed to call the API and open WebSockets
ALLOWED_ORIGINS=http://localhost:3000

# --- Backend tests ---
# Uncomment to run the database tests with `go test ./...`; they use temporary
# schemas, so pointing this at the development database is safe
# TEST_DATABASE_URL=postgres://chatuser:chatpass@localhost:5432/chatapp?sslmode=disable
