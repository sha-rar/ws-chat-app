# Frontend-specific ignores (node_modules, .next, coverage, ...) live in frontend/.gitignore

# Local settings and secrets; the example files document every variable
.env
.env.*
!.env.example

# Local-only notes
workflow.md

# Editor and OS files
.history/
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Go build and test output
/backend/server
/backend/bin/
*.exe
*.test
*.out
*.prof
coverage.*
go.work
go.work.sum

# Node, in case anything is installed outside frontend/
node_modules/
npm-debug.log*

# Logs
*.log

# Claude Code local settings
.claude/settings.local.json
